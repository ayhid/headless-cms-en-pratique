# ------------------------------------------------------------------
# Serveur Strapi
# ------------------------------------------------------------------
# Adresse d'ecoute du serveur Strapi (0.0.0.0 = toutes les interfaces)
HOST=0.0.0.0
# Port HTTP de Strapi. 1337 en integration ; en phase 2 chaque agent prend le sien (1338 a 1343)
PORT=1337

# ------------------------------------------------------------------
# Secrets Strapi (generer avec : node -p "require('crypto').randomBytes(16).toString('base64')")
# ------------------------------------------------------------------
# Cles de signature des cookies de session, 4 valeurs separees par des virgules
APP_KEYS=cle1,cle2,cle3,cle4
# Sel utilise pour hacher les API tokens. LE CHANGER INVALIDE TOUS LES TOKENS existants
API_TOKEN_SALT=aRemplacer
# Secret de signature des JWT de l'admin
ADMIN_JWT_SECRET=aRemplacer
# Sel des transfer tokens (strapi transfer)
TRANSFER_TOKEN_SALT=aRemplacer
# Secret des JWT du plugin Users & Permissions (utilisateurs finaux)
JWT_SECRET=aRemplacer
# Cle de chiffrement : rend les API tokens consultables a tout moment dans l'admin
ENCRYPTION_KEY=aRemplacer

# ------------------------------------------------------------------
# Base de donnees (SQLite locale, un fichier par worktree)
# ------------------------------------------------------------------
# Moteur de base : sqlite pour la demo
DATABASE_CLIENT=sqlite
# Chemin du fichier SQLite, relatif a la racine du projet
DATABASE_FILENAME=.tmp/data.db

# ------------------------------------------------------------------
# Donnees de demo (lues par le bootstrap de src/index.ts)
# ------------------------------------------------------------------
# E-mail du super admin de demo, cree au demarrage s'il n'existe pas
DEMO_ADMIN_EMAIL=admin@example.com
# Mot de passe du super admin de demo (8 caracteres min., une majuscule, un chiffre)
DEMO_ADMIN_PASSWORD=DemoStrapi2026!
# Valeur FIXE de l'API token "read-only" utilise par le front (le bootstrap l'impose en base)
STRAPI_READ_TOKEN=demo-read-aRemplacer
# Valeur FIXE de l'API token de preview (lecture des brouillons via status=draft)
STRAPI_PREVIEW_TOKEN=demo-preview-aRemplacer
# Secret partage envoye par le webhook Strapi au front (header Authorization: Bearer ...)
WEBHOOK_SECRET=demo-webhook-aRemplacer
# true = mode demo (crons acceleres, etc. : utilise par les agents de phase 2)
DEMO_MODE=true
# URL du front Next.js (cible du webhook de revalidation : FRONTEND_URL/api/revalidate)
FRONTEND_URL=http://localhost:3000
# Secret de l'URL de preview (draftMode Next.js), meme valeur que PREVIEW_SECRET de frontend/.env
PREVIEW_SECRET=demo-preview-secret-aRemplacer
# (optionnel, lu par demo:start) port du front Next.js, 3000 par defaut ; 3001 a 3006 en phase 2
# FRONT_PORT=3000
