# URL de l'API Strapi (sans slash final). 1337 en integration, port de l'agent en phase 2
STRAPI_URL=http://localhost:1337
# API token read-only du front (meme valeur que STRAPI_READ_TOKEN du .env racine)
STRAPI_READ_TOKEN=demo-read-aRemplacer
# API token de preview, lecture des brouillons (meme valeur que STRAPI_PREVIEW_TOKEN du .env racine)
STRAPI_PREVIEW_TOKEN=demo-preview-aRemplacer
# Secret attendu dans le header Authorization du webhook Strapi (meme valeur que WEBHOOK_SECRET racine)
WEBHOOK_SECRET=demo-webhook-aRemplacer
# Secret de l'URL de preview (draftMode) partage entre l'admin Strapi et le front
PREVIEW_SECRET=demo-preview-secret-aRemplacer
